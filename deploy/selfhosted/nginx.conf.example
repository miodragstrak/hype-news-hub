# OPTIONAL REFERENCE ONLY: Nginx is not assumed installed. Do not install this as-is.
# Adapt equivalent routing/access policy to the administrator's existing ingress.
# Replace every __PLACEHOLDER__; keep deny-all until Sprint 14B access review.
server {
    listen 443 ssl;
    server_name __INTERNAL_HOSTNAME__;
    ssl_certificate __CERTIFICATE_PATH__;
    ssl_certificate_key __PRIVATE_KEY_PATH__;

    deny all; # Intentional. Replace only with reviewed VPN/SSO ingress protection in 14B.
    client_max_body_size 1m;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;

    location ~ ^/(ready|docs|redoc|openapi\.json)(/|$) { return 404; }
    location ~ ^/api(/|$) {
        # No trailing URI: preserve /api exactly. No cache and no automatic command retries.
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_connect_timeout 5s;
        # Initial budget for six serial source deadlines plus DB work; measure in staging.
        proxy_read_timeout 180s;
        proxy_send_timeout 30s;
    }
    location / {
        proxy_pass http://127.0.0.1:__WEB_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
