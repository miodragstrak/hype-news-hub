# For docker-compose.selfhosted.yml ONLY. Copy outside the checkout; no credentials here.
HNW_PROJECT_NAME=hype-world-news
HNW_RELEASE=replace-with-reviewed-release
HNW_PUBLIC_ORIGIN=https://news.example.invalid
HNW_DB_NAME=hype_world_news
HNW_DB_OWNER=hwn_owner
HNW_DB_RUNTIME=hwn_runtime
# Absolute files on the Docker host, not passwords. Create distinct random secrets.
HNW_DB_OWNER_PASSWORD_FILE=/etc/hype-world-news/secrets/db-owner
HNW_DB_RUNTIME_PASSWORD_FILE=/etc/hype-world-news/secrets/db-runtime
# API/tools run non-root. Secret files must be readable by the selected container GID.
HNW_APP_UID=10001
HNW_APP_GID=10001
# Starting ceilings, NOT a capacity assessment of the shared server.
HNW_DB_MEMORY=1g
HNW_DB_CPUS=1.0
HNW_API_MEMORY=512m
HNW_API_CPUS=1.0
HNW_WEB_MEMORY=128m
HNW_WEB_CPUS=0.5
# Optional host-proxy overlay ONLY. Administrator must choose two unused ports.
HNW_WEB_BIND_PORT=
HNW_API_BIND_PORT=
# Before 14B activation, set only actual trusted proxy IPs/CIDRs. Never '*'.
HNW_TRUSTED_PROXY_IPS=127.0.0.1
# Opt in only after migrations/provisioning/bootstrap and reviewed Nginx HTTPS routing.
HNW_AUTH_ENABLED=false
HNW_AUTH_SESSION_SECONDS=28800

# Optional AI overlay ONLY: these variables do not activate AI in the base stack.
# Requires authenticated operation, an explicitly selected available model and a protected key file.
HNW_GEMINI_MODEL=
HNW_GEMINI_API_KEY_FILE=
HNW_GEMINI_MAX_INPUT_TOKENS=4096
HNW_GEMINI_MAX_OUTPUT_TOKENS=2048
HNW_AI_DAILY_GENERATION_LIMIT=10
