APP_NAME=Hype News Hub
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://hype-news-hub.vercel.app
# Only this project's branch and nine-character commit Preview URLs in this Vercel team.
# Set an empty value to disable Preview origins; exact origins above still apply.
BACKEND_CORS_ORIGIN_REGEX=^https://hype-news-hub-(?:git-[a-z0-9-]+|[a-z0-9]{9})-miodrag-straks-projects\.vercel\.app$
DISCOVERY_TIMEOUT_SECONDS=8
# PostgreSQL: new story memberships require publication dates within this gap.
STORY_MATCH_MAX_GAP_HOURS=48
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hype_news_hub
NEWS_STORAGE_BACKEND=memory
# Native PostgreSQL API mode must use the restricted runtime role.
# Native Alembic/provisioning commands need separately supplied owner credentials.
POSTGRES_USER=hype_news_hub_runtime
# Required for postgres mode; memory mode does not access the database.
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
