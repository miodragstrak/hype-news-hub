APP_NAME=Hype News Hub
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://hype-news-hub.vercel.app
# Only this project's branch and nine-character commit Preview URLs in this Vercel team.
# Set an empty value to disable Preview origins; exact origins above still apply.
BACKEND_CORS_ORIGIN_REGEX=^https://hype-news-hub-(?:git-[a-z0-9-]+|[a-z0-9]{9})-miodrag-straks-projects\.vercel\.app$
# Shared WordPress/discovery HTTP bounds, including every redirect hop.
SOURCE_HTTP_CONNECT_TIMEOUT_SECONDS=5
SOURCE_HTTP_READ_TIMEOUT_SECONDS=10
SOURCE_HTTP_REQUEST_DEADLINE_SECONDS=20
SOURCE_HTTP_MAX_RESPONSE_BYTES=5242880
SOURCE_HTTP_MAX_REDIRECTS=3
# Legacy setting accepted for compatibility; SOURCE_HTTP_* now controls discovery.
DISCOVERY_TIMEOUT_SECONDS=8
# PostgreSQL: new story memberships require publication dates within this gap.
STORY_MATCH_MAX_GAP_HOURS=48
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hype_news_hub
NEWS_STORAGE_BACKEND=memory
# Native PostgreSQL API mode must use the restricted runtime role.
# Native Alembic/provisioning commands need separately supplied owner credentials.
POSTGRES_USER=hype_news_hub_runtime
# Required for postgres mode; memory mode does not access the database.
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
# Private single-source AI: disabled by default; mock is not real translation.
# No identity bypass; PostgreSQL and verified editorial identity are still required.
AI_PROCESSING_PROVIDER=disabled
AI_PROCESSING_TIMEOUT_SECONDS=5
# Optional local opt-in: AI_PROCESSING_PROVIDER=gemini, with a reviewed available
# text model and a protected server-side key. No model/key default or fallback.
# For a separately approved live test, set AI_PROCESSING_TIMEOUT_SECONDS=30.
GEMINI_MODEL=
GEMINI_API_KEY=
GEMINI_MAX_INPUT_TOKENS=4096
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_SAFE_RETRIES=1
