FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ARG APP_UID=10001
ARG APP_GID=10001
RUN groupadd --gid "$APP_GID" newsroom && useradd --uid "$APP_UID" --gid newsroom --no-create-home newsroom
COPY requirements.txt requirements.selfhosted.lock ./
RUN python -m pip install --no-cache-dir --disable-pip-version-check pip==26.2 \
    && python -m pip install --no-cache-dir --disable-pip-version-check -r requirements.selfhosted.lock \
    && python -m pip check
COPY app ./app
COPY alembic.ini ./
COPY alembic ./alembic
USER newsroom
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=12s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=10)"
CMD ["python", "-m", "uvicorn", "app.selfhosted:create_selfhosted_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-proxy-headers", "--timeout-graceful-shutdown", "40"]
