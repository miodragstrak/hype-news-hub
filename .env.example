# Docker Compose settings for this application's dedicated local/private database.
COMPOSE_PROJECT_NAME=hype-news-hub
POSTGRES_DB=hype_news_hub
POSTGRES_USER=hype_news_hub
# Generate locally; do not commit .env. Required by normal Compose services.
POSTGRES_PASSWORD=
# Separate, disposable integration-test instance (test profile only).
POSTGRES_TEST_PASSWORD=
# Explicit opt-in; Render/default application behavior remains memory-based.
NEWS_STORAGE_BACKEND=memory
STORY_MATCH_MAX_GAP_HOURS=48
POSTGRES_RUNTIME_USER=hype_news_hub_runtime
# Separate from the bootstrap/migration password; generate at least 24 characters.
POSTGRES_RUNTIME_PASSWORD=

# AI remains disabled unless explicitly opted in; never place keys in VITE_* variables.
AI_PROCESSING_PROVIDER=disabled
AI_PROCESSING_TIMEOUT_SECONDS=30
AI_DAILY_GENERATION_LIMIT=10
GEMINI_MODEL=
GEMINI_API_KEY=
GEMINI_MAX_INPUT_TOKENS=4096
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_SAFE_RETRIES=0
